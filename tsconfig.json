{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "target": "ES2020"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
